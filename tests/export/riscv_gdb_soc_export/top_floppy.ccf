Pin_out   "HYPER_CKn"   Loc = "IO_SA_B6";
Pin_out   "HYPER_CSn"   Loc = "IO_SA_B4";
Pin_inout "HYPER_RWDS"  Loc = "IO_SA_B2";
Pin_inout "HYPER_DQ0"   Loc = "IO_SA_B5";
Pin_inout "HYPER_DQ1"   Loc = "IO_SA_B8";
Pin_inout "HYPER_DQ2"   Loc = "IO_SA_B0";
Pin_inout "HYPER_DQ3"   Loc = "IO_SA_B3";
Pin_inout "HYPER_DQ4"   Loc = "IO_SA_A0";
Pin_inout "HYPER_DQ5"   Loc = "IO_SA_A3";
Pin_inout "HYPER_DQ6"   Loc = "IO_SA_A5";
Pin_inout "HYPER_DQ7"   Loc = "IO_SA_A8";

