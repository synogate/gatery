Pin_out     "DISPLAY_RXOCn"   Loc = "IO_WC_B3";

Pin_out     "DISPLAY_EN_12V"  Loc = "IO_WC_B7";
Pin_out     "DISPLAY_BL_EN"   Loc = "IO_WB_B4";
Pin_out     "DISPLAY_BL_PWM"  Loc = "IO_WB_A4";

# RMII
Pin_out     "rmii_tx_en"    Loc = "IO_SB_A0" | FF_OBF=true;
Pin_out     "rmii_txd[0]"   Loc = "IO_SB_A1" | FF_OBF=true;
Pin_out     "rmii_txd[1]"   Loc = "IO_SB_B0" | FF_OBF=true;
Pin_in      "rmii_crs_dv"   Loc = "IO_SB_B1";
Pin_in      "rmii_rxd[0]"   Loc = "IO_SB_A2";
Pin_in      "rmii_rxd[1]"   Loc = "IO_SB_B2";
Pin_out     "rmii_ref_clk"  Loc = "IO_SB_A3";
Pin_out     "rmii_rst"      Loc = "IO_SB_A5";
Pin_out     "rmii_mdc"      Loc = "IO_SB_B6";
Pin_out     "rmii_mdio"     Loc = "IO_SB_B8";

# rotary encoder port
Pin_in      "ROT_A"     Loc = "IO_SB_A7" | PULLUP=true | SCHMITT_TRIGGER=true;
Pin_in      "ROT_B"     Loc = "IO_SB_B4" | PULLUP=true | SCHMITT_TRIGGER=true;
Pin_in      "ROT_SW"    Loc = "IO_SB_A4" | PULLUP=true | SCHMITT_TRIGGER=true;
