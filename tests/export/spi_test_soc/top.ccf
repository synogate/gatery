#Pin_out     "SD_DAT2"          Loc = "IO_EA_B8";
#Pin_out     "SD_DAT3"          Loc = "IO_EA_A8";

# SD2
Pin_out     "SD_CLK"           Loc = "IO_EA_A6";
Pin_out     "SD_CMD"           Loc = "IO_EA_B6";
Pin_in      "SD_DAT0"          Loc = "IO_EA_A2" | PULLUP=true;
Pin_out     "SD_DAT1"          Loc = "IO_EA_B2";
Pin_out     "SD_DAT2"          Loc = "IO_EA_A4";
Pin_out     "SD_DAT3"          Loc = "IO_EA_B4";
